# Brainy — environment template (safe comments only; never put real secrets here)
# Copy to `.env.local` for local development. Configure production in the host dashboard.

# =============================================================================
# Recommended first production launch posture
# =============================================================================
# - Set ONE live shopping provider (Serper preferred).
# - Leave OPENAI_ENRICHMENT_ENABLED unset/false (heuristics-only statements).
# - Leave PRODUCT_COMPARE_DEMO_MODE unset/false.
# - Leave CRON_SECRET unset unless you intentionally enable the simulated cron.
# - Configure platform WAF / rate limits before sharing the public URL.
# See docs/DEPLOYMENT.md

# -----------------------------------------------------------------------------
# Shopping discovery (server-only; required for live Compare / Shopping Assistant)
# -----------------------------------------------------------------------------
# Primary: Serper Google Shopping
SERPER_API_KEY=
# Optional Serper endpoint overrides (defaults are fine)
# PRODUCT_SERPER_SHOPPING_URL=
# PRODUCT_SERPER_SEARCH_URL=

# Fallback when Serper is missing or fails
SERPAPI_API_KEY=

# Locale for shopping search (optional)
# PRODUCT_SHOPPING_GL=us
# PRODUCT_SHOPPING_HL=en

# Synthetic listings only — NEVER enable on a public production deployment
# PRODUCT_COMPARE_DEMO_MODE=true

# -----------------------------------------------------------------------------
# OpenAI enrichment (server-only; paid; OPT-IN)
# -----------------------------------------------------------------------------
# A key alone does NOT enable AI. Both are required for any OpenAI network call:
OPENAI_API_KEY=
OPENAI_ENRICHMENT_ENABLED=false

# Optional model / timeout overrides (only used when enrichment is enabled)
# OPENAI_COMPARE_MODEL=
# OPENAI_COMPARE_TIMEOUT_MS=
# OPENAI_SUBSCRIPTIONS_MODEL=
# OPENAI_SUBSCRIPTIONS_TIMEOUT_MS=
# OPENAI_TRANSACTIONS_MODEL=
# OPENAI_MERCHANT_NORMALIZE_MODEL=
# OPENAI_RECOMMENDATIONS_MODEL=
# Second gate for recommendation copy rewrite (also needs OPENAI_ENRICHMENT_ENABLED)
# OPENAI_RECOMMENDATIONS_WORDING=false

# -----------------------------------------------------------------------------
# Cron / simulated price alerts (server-only)
# -----------------------------------------------------------------------------
# Production refuses cron without this secret. Prefer omit for first launch.
# CRON_SECRET=

# -----------------------------------------------------------------------------
# Optional affiliate tags (server-only; unused until partner programs are live)
# -----------------------------------------------------------------------------
# AMAZON_ASSOCIATE_TAG=
# WALMART_AFFILIATE_SID=
# TARGET_PARTNER_SUBID=

# -----------------------------------------------------------------------------
# Debug flags (keep off in production)
# -----------------------------------------------------------------------------
# DEBUG_COMPARE=false
# PRODUCT_SHOPPING_DEBUG=0
# PRODUCT_SERP_DEBUG=0
# DEPARTMENT_PIPELINE_STRICT=false
# DEPARTMENT_HARD_GATES_V2=false
# PRODUCT_ENABLE_SEARCH_TO_PDP_UPGRADE=false
# PRODUCT_SEARCH_TO_PDP_TIMEOUT_MS=
# PDP_UNIVERSAL_DEBUG=0

# -----------------------------------------------------------------------------
# Local-only (development)
# -----------------------------------------------------------------------------
# DISABLE_DEV_BACKGROUND_TASKS=true
# NEXT_PUBLIC_DISABLE_DEV_BACKGROUND_TASKS=true
